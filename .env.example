# Copy to .env.local for `vercel dev` — never commit real values.

# Admin login (set on Vercel Project → Environment Variables)
SAKURA_ADMIN_PASSWORD=

# Optional: dedicated HMAC secret for admin sessions (recommended in production)
SAKURA_ADMIN_SESSION_SECRET=

# Supabase — service role reads job_applications (never expose to the browser)
SAKURA_SUPABASE_URL=
SAKURA_SUPABASE_SERVICE_ROLE_KEY=

# Careers form (public anon key — already used by /jobs/ apply flow)
SAKURA_SUPABASE_ANON_KEY=
